{
  "compilerOptions": {
    "target": "ES2022",
    "module": "Node16",
    "moduleResolution": "Node16",
    "lib": ["ES2022"],
    "outDir": "dist",
    "rootDir": "src",
    "strict": true,
    "noEmitOnError": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": false,
    // Comments are preserved by default, and `files: ["dist"]` publishes dist,
    // so every source comment ships to npm in readable JavaScript. Strip them:
    // the comments in this codebase explain decisions to whoever maintains it,
    // which is not the same audience as whoever installs it.
    "removeComments": true,
    "sourceMap": false
  },
  "include": ["src/**/*.ts"]
}
