{
  "name": "@bannerbear/mcp",
  "version": "0.3.0",
  "description": "Model Context Protocol server for the Bannerbear V5 API",
  "license": "MIT",
  "type": "module",
  "bin": {
    "bannerbear-mcp": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "codegen": "node scripts/codegen.mjs",
    "build": "npm run codegen && tsc",
    "dev": "npm run build && node dist/index.js",
    "prepublishOnly": "npm run build",
    "test": "node scripts/test-layers.mjs && node scripts/test-scopes.mjs",
    "test:live": "node scripts/test-live.mjs",
    "smoke": "node scripts/smoke.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yongfook/bannerbear-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/yongfook/bannerbear-mcp/issues"
  },
  "homepage": "https://github.com/yongfook/bannerbear-mcp#readme",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "bannerbear",
    "image-generation",
    "video-generation",
    "claude"
  ]
}
